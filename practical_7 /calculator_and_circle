# Calculator part

class Calculator:
    def __init__(self, number1, number2):
        self.number1 = number1
        self.number2 = number2

    def add(self):
        sum = self.number1 + self.number2
        return(sum)

    def subtract(self):
        difference = self.number1 - self.number2
        return(difference)

    def multiply(self):
        product = self.number1 * self.number2
        return(product)
        
my_calc = Calculator(4,6)
print(my_calc.add())
print(my_calc.subtract())
print(my_calc.multiply())

# Circle part

class Circle():
    def __init__(self, radius):
        self.radius = int(radius)
        self.circumference = self.calc_perimeter()
        self.area = self.calc_area()

    def calc_perimeter(self):
        import math
        circumference = 2 * math.pi * self.radius
        return(circumference)

    def calc_area(self):
        import math
        area = math.pi * self.radius ** 2
        return(area)

circle1 = Circle(input("Insert your circle's radius: "))

print(f"Your circle has a radius of: {circle1.radius}")
print(f"Your circle has a circumference of {circle1.circumference}")
print(f"Your circle has an area of {circle1.area}")
